# Builds the storefront and the admin portal (two separate apps) and serves them with Caddy,
# which also forwards /api and /uploads to the API container and handles HTTPS.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Where the admin's "Back to site" link points, e.g. https://fgttrading.ph (empty = /store).
ARG VITE_STORE_URL=
ENV VITE_STORE_URL=$VITE_STORE_URL
RUN npm run build

FROM caddy:2-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist/store /srv/store
COPY --from=build /app/dist/admin /srv/admin
EXPOSE 80 443
