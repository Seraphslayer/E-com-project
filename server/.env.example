# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Your MongoDB connection string. Examples:
#   Local:  mongodb://127.0.0.1:27017/fgt
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fgt?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/fgt

# Long random string used to sign admin login tokens (32+ characters).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Websites allowed to call the API from a browser (comma separated, no trailing slash).
CORS_ORIGINS=http://localhost:8443,http://localhost:5173

# Where uploaded product photos/videos are stored, and the per-file size limit.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# First admin account, created automatically when no users exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
