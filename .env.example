# Used by docker-compose.yml. Copy to .env and fill in. Never commit .env.

# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First admin login, created on first start when no users exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The public address of the site (what people type in the browser), no trailing slash.
CORS_ORIGINS=http://localhost

# Optional: use your own MongoDB (e.g. Atlas) instead of the bundled one.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fgt?retryWrites=true&w=majority

# Optional: port the site is served on.
# WEB_PORT=80
