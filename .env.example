# Used by docker-compose.yml. Copy to .env and fill in. Never commit .env.

# Addresses of the two sites (no https://, no trailing slash). The DNS records for both must point to the server.
#   Test on your own computer:  STORE_DOMAIN=http://localhost   ADMIN_DOMAIN=http://admin.localhost
STORE_DOMAIN=
ADMIN_DOMAIN=

# Full public addresses with https://, comma separated. Used by the API to allow the browser calls
# and to build the return links after payment. SITE_URL is the storefront.
CORS_ORIGINS=
SITE_URL=

# Where the admin "Back to site" link goes, e.g. https://fgttrading.ph (empty = /store).
# VITE_STORE_URL=

# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First admin login, created on first start when no users exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: use MongoDB Atlas instead of the bundled database.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fgt?retryWrites=true&w=majority

# Maya Checkout (online payment). Leave empty to keep only bank transfer / pay on delivery.
# Demo: public sandbox keys from https://developers.maya.ph/reference/sandbox-credentials-and-cards
# Live: FGT's own keys from Maya, plus MAYA_API_URL=https://pg.maya.ph
# MAYA_PUBLIC_KEY=
# MAYA_SECRET_KEY=
# MAYA_API_URL=https://pg-sandbox.paymaya.com

# Frontend (Vite): address of the API when it is NOT on the same domain as the site. LEAVE EMPTY normally
# (on AWS, Vercel and in local development the site calls /api on its own domain).
# VITE_API_URL=
